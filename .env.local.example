# ── Supabase (same instance as lca-project-planner) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (email for contact form) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Ans Imran Shahid <hello@yourdomain.com>

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ans-imran-portfolio.vercel.app

# ── Admin (portfolio admin at /admin) ─────────────────────────────────────────
# ADMIN_PASSWORD: the password you type to sign in.
# ADMIN_SESSION_SECRET: a long random string used to sign the session cookie
#   (generate with:  openssl rand -hex 32).
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-hex-string

# Analytics is now self-hosted at /api/track (writes to portfolio_events in
# Supabase). NEXT_PUBLIC_ANALYTICS_ENDPOINT is no longer used.
